LILSMOKE_OD_SDL_VERSION = 1
LILSMOKE_OD_SDL_SITE = $(patsubst %/,%,$(LILSMOKE_OD_SDL_PKGDIR))
LILSMOKE_OD_SDL_SITE_METHOD = local
LILSMOKE_OD_SDL_LICENSE = MPL-2.0
LILSMOKE_OD_SDL_LICENSE_FILES = LICENSE
LILSMOKE_OD_SDL_DEPENDENCIES = sdl2 lilsmoke-sdl12
define LILSMOKE_OD_SDL_BUILD_CMDS
	$(TARGET_MAKE_ENV) $(MAKE) -C $(@D) CC="$(TARGET_CC)" CXX="$(TARGET_CXX)" \
		CFLAGS="$(TARGET_CFLAGS)" CXXFLAGS="$(TARGET_CXXFLAGS)" \
		PROJECT="$(abspath $(LILSMOKE_OD_SDL_PKGDIR)/../..)" \
		SDL2_INCLUDE="$(STAGING_DIR)/usr/include/SDL2" \
		SDL12_INCLUDE="$(STAGING_DIR)/usr/include/SDL"
endef
define LILSMOKE_OD_SDL_INSTALL_TARGET_CMDS
	$(INSTALL) -D -m 0755 $(@D)/libod-sdl.so $(TARGET_DIR)/usr/lib/lilsmoke/libod-sdl.so
endef
$(eval $(generic-package))
