config BR2_PACKAGE_LILSMOKE_BLUETOOTH
	bool "LilSmoke Bluetooth (optional)"
	depends on BR2_USE_MMU
	depends on BR2_USE_WCHAR
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS_NPTL
	depends on !BR2_STATIC_LIBS
	depends on BR2_TOOLCHAIN_HEADERS_AT_LEAST_3_18
	depends on BR2_TOOLCHAIN_GCC_AT_LEAST_4_9
	depends on BR2_TOOLCHAIN_HAS_SYNC_4
	select BR2_PACKAGE_BLUEZ5_UTILS
	select BR2_PACKAGE_BLUEZ5_UTILS_PLUGINS_HID
	select BR2_PACKAGE_BLUEZ_ALSA
	help
	  Optional BlueZ HID/HOG and BlueALSA SBC audio with native pairing UI.
	  Off at runtime by default. Requires a supported Bluetooth adapter,
	  its board/USB driver and firmware. No PulseAudio, X11 or GPU required.
	  Bond keys stay on /persist, outside the USB-exported ROM partition.
	  A2DP headphones/speakers and HSP/HFP audio endpoints are exposed;
	  microphone use depends on an application's capture support.
