config BR2_PACKAGE_LILSMOKE_FFMPEG
    bool "LilSmoke FFmpeg tools and software media libraries"
    depends on BR2_TOOLCHAIN_HAS_THREADS
    depends on !BR2_STATIC_LIBS
    select BR2_PACKAGE_ZLIB
    help
      FFmpeg and ffprobe with software codecs, filters, local files and pipes.
      Includes the libraries used by the native media player. No GPU, network
      protocols, graphical ffplay dependency or background media services.
