# Some legacy .pc files embed an absolute staging include path. pkgconf then
# prefixes it again. Recover only an existing directory inside a trusted root.
function(lilsmoke_pkg_include path output)
    if(NOT CMAKE_CROSSCOMPILING)
        set(${output} "${path}" PARENT_SCOPE)
        return()
    endif()
    set(roots "${CMAKE_SYSROOT}" "$ENV{PKG_CONFIG_SYSROOT_DIR}" ${CMAKE_FIND_ROOT_PATH})
    list(REMOVE_DUPLICATES roots)
    set(candidates "${path}")
    foreach(root IN LISTS roots)
        if(NOT IS_ABSOLUTE "${root}" OR NOT IS_DIRECTORY "${root}")
            continue()
        endif()
        string(REGEX REPLACE "/+$" "" root "${root}")
        string(FIND "${path}" "${root}/" position)
        if(position EQUAL 0)
            string(LENGTH "${root}" length)
            string(SUBSTRING "${path}" ${length} -1 unprefixed)
            list(APPEND candidates "${unprefixed}")
        endif()
    endforeach()
    foreach(candidate IN LISTS candidates)
        if(NOT IS_ABSOLUTE "${candidate}" OR NOT IS_DIRECTORY "${candidate}")
            continue()
        endif()
        get_filename_component(real_candidate "${candidate}" REALPATH)
        foreach(root IN LISTS roots)
            if(NOT IS_ABSOLUTE "${root}" OR NOT IS_DIRECTORY "${root}")
                continue()
            endif()
            get_filename_component(real_root "${root}" REALPATH)
            # Boundary-aware containment, including symlink and '..' resolution.
            string(FIND "${real_candidate}/" "${real_root}/" inside)
            if(inside EQUAL 0)
                if(NOT IS_DIRECTORY "${path}")
                    message(STATUS "Repaired sysroot-prefixed pkg-config include: ${path} -> ${real_candidate}")
                endif()
                set(${output} "${real_candidate}" PARENT_SCOPE)
                return()
            endif()
        endforeach()
    endforeach()
    message(FATAL_ERROR "Pkg-config include cannot be resolved within a configured target sysroot: ${path}")
endfunction()

function(lilsmoke_fix_pkg_target target)
    get_target_property(includes "${target}" INTERFACE_INCLUDE_DIRECTORIES)
    if(includes)
        set(fixed)
        foreach(path IN LISTS includes)
            lilsmoke_pkg_include("${path}" normalized)
            list(APPEND fixed "${normalized}")
        endforeach()
        list(REMOVE_DUPLICATES fixed)
        set_property(TARGET "${target}" PROPERTY INTERFACE_INCLUDE_DIRECTORIES "${fixed}")
    endif()
    get_target_property(options "${target}" INTERFACE_COMPILE_OPTIONS)
    if(options)
        set(fixed)
        set(prefix "")
        foreach(option IN LISTS options)
            if(prefix)
                lilsmoke_pkg_include("${option}" normalized)
                list(APPEND fixed "${prefix}" "${normalized}")
                set(prefix "")
            elseif(option STREQUAL "-I" OR option STREQUAL "-isystem")
                set(prefix "${option}")
            elseif(option MATCHES "^-I(.+)$")
                lilsmoke_pkg_include("${CMAKE_MATCH_1}" normalized)
                list(APPEND fixed "-I${normalized}")
            elseif(option MATCHES "^-isystem(.+)$")
                lilsmoke_pkg_include("${CMAKE_MATCH_1}" normalized)
                list(APPEND fixed "-isystem${normalized}")
            else()
                list(APPEND fixed "${option}")
            endif()
        endforeach()
        if(prefix)
            message(FATAL_ERROR "Dangling pkg-config include option on ${target}: ${prefix}")
        endif()
        set_property(TARGET "${target}" PROPERTY INTERFACE_COMPILE_OPTIONS "${fixed}")
    endif()
endfunction()
