#!/bin/sh
# SPDX-License-Identifier: MPL-2.0
# UI has already destroyed SDL/DirectFB before execing this wrapper.
helper=
terminate() {
    trap - HUP INT TERM
    # wait is interruptible; a synchronous foreground command defers traps.
    child=${helper:-$!}
    if [ -n "$child" ]; then
        kill -TERM "$child" 2>/dev/null || true
        wait "$child" 2>/dev/null || true
    fi
    exit 0
}
trap terminate HUP INT TERM
/usr/bin/lilsmoke-terminal &
helper=$!
wait "$helper"
status=$?
helper=
if [ "$status" -ne 0 ]; then
    printf 'LilSmoke Shell exited with status %s\n' "$status" >&2
fi
# Keep the launcher's supervised PID and never run two frontend instances.
trap - HUP INT TERM
exec /usr/bin/lilsmoke-ui
