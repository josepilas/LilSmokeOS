LILSMOKE_SDL12_VERSION = 35ef746cf1a4fde8c442dc92fe9b18c3f90d7855
LILSMOKE_SDL12_SITE = https://github.com/libsdl-org/sdl12-compat.git
LILSMOKE_SDL12_SITE_METHOD = git
LILSMOKE_SDL12_LICENSE = Zlib
LILSMOKE_SDL12_LICENSE_FILES = LICENSE.txt
LILSMOKE_SDL12_DEPENDENCIES = sdl2
LILSMOKE_SDL12_INSTALL_STAGING = YES
LILSMOKE_SDL12_CONF_OPTS = -DSDL12TESTS=OFF -DSDL12DEVEL=ON -DSTATICDEVEL=OFF
ifeq ($(BR2_PACKAGE_DIRECTFB),y)
LILSMOKE_SDL12_CONF_OPTS += -DCMAKE_C_FLAGS="$(TARGET_CFLAGS) -I$(STAGING_DIR)/usr/include/directfb"
endif
$(eval $(cmake-package))
