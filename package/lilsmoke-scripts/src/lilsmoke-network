#!/bin/sh
set -eu
READ="${LILSMOKE_CONFIG_READER:-/usr/lib/lilsmoke/lilsmoke-config-read}"
RUN="${LILSMOKE_NETWORK_RUN_DIR:-/run/lilsmoke-network}"
NET="${LILSMOKE_NET_CLASS:-/sys/class/net}"
WIFI_CONF="${LILSMOKE_WIFI_CONFIG:-/persist/config/wifi.conf}"
mkdir -p "$RUN"
stop() {
    for file in "$RUN"/dhcp-*.pid "$RUN"/wpa-*.pid; do
        [ -f "$file" ] || continue
        case "$file" in */dhcp-*) name=udhcpc ;; *) name=wpa_supplicant ;; esac
        start-stop-daemon -K -q -p "$file" -n "$name" 2>/dev/null || true
        rm -f "$file"
    done
    if [ -f "$RUN/wlan" ]; then
        interface=$(cat "$RUN/wlan")
        ip addr flush dev "$interface" 2>/dev/null || true
        ip link set "$interface" down 2>/dev/null || true
        rm -f "$RUN/wlan"
    fi
}
dhcp() {
    # Stay running to renew leases; background while association is pending.
    udhcpc -i "$1" -p "$RUN/dhcp-$1.pid" -b -t 5
}
start() {
    if [ -e "$NET/eth0" ] && [ ! -f "$RUN/dhcp-eth0.pid" ]; then
        ip link set eth0 up
        dhcp eth0
    fi
    enabled=$("$READ" WIFI_ENABLED off)
    case "$enabled" in 1|on|true|yes) ;; *) return 0 ;; esac
    [ -s "$WIFI_CONF" ] || { echo "No saved Wi-Fi credentials"; return 0; }
    interface=""
    for path in "$NET"/*; do
        [ -d "$path/wireless" ] || [ -L "$path/phy80211" ] || continue
        interface=${path##*/}
        break
    done
    [ -n "$interface" ] || { echo "No supported Wi-Fi adapter"; return 0; }
    [ ! -f "$RUN/wpa-$interface.pid" ] || return 0
    printf '%s\n' "$interface" > "$RUN/wlan"
    ip link set "$interface" up
    wpa_supplicant -B -P "$RUN/wpa-$interface.pid" -i "$interface" -c "$WIFI_CONF"
    address=$("$READ" WIFI_IPV4 dhcp)
    case "$address" in
        ''|dhcp) dhcp "$interface" ;;
        *)
            case "$address" in */*) ;; *) address="$address/24" ;; esac
            printf '%s\n' "$address" | awk -F'[./]' '
                NF!=5 {exit 1}
                {for(i=1;i<=5;i++) if ($i !~ /^[0-9]+$/ || length($i)>3) exit 1}
                {for(i=1;i<=4;i++) if ($i>255) exit 1}
                $5<1 || $5>30 || $1==0 || $1==127 || $1>=224 {exit 1}
            ' || { echo "Invalid WIFI_IPV4"; return 1; }
            ip addr flush dev "$interface"
            ip addr add "$address" dev "$interface" ;;
    esac
}
case "${1:-start}" in
    start) start ;;
    stop) stop ;;
    restart) stop; start ;;
    *) echo "usage: $0 {start|stop|restart}" >&2; exit 64 ;;
esac
