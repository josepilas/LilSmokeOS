 	MenuMessageBox("Loading ROM...",mRomName,"",MENU_MESSAGE_BOX_MODE_MSG);
+	const char *resolved = od_resolve_content(mRomName, "snes");
+	if (!resolved || strlen(resolved) >= sizeof(mRomName)) {
+		fprintf(stderr, "POCKETSNES_NATIVE_BROWSER_RESOLVE_FAILED\n");
+		return SAL_ERROR;
+	}
+	if (resolved != mRomName) strcpy(mRomName, resolved);
+	fprintf(stderr, "POCKETSNES_NATIVE_BROWSER_LOAD %s\n", mRomName);
 	if (!Memory.LoadROM (mRomName))
 	{
 		MenuMessageBox("Loading ROM",mRomName,"Failed!",MENU_MESSAGE_BOX_MODE_PAUSE);
