config BR2_PACKAGE_OPENDINGUX_EMULATORS
    bool "PocketSNES (OpenDingux/RetroFW source port)"
    depends on BR2_INSTALL_LIBSTDCPP
    depends on BR2_USE_MMU
    depends on BR2_TOOLCHAIN_HAS_THREADS
    depends on !BR2_STATIC_LIBS
    depends on !BR2_PACKAGE_SDL
    select BR2_PACKAGE_LILSMOKE_SDL12
    select BR2_PACKAGE_ZLIB
    select BR2_PACKAGE_LIBPNG
    help
      Pinned PocketSNES rebuilt for the target libc using SDL 1.2 compatibility
      over SDL2/DirectFB software rendering. No OpenGL or clock-register writes.
      PCSX4ALL is packaged independently with a native SDL2 frontend.
      Other vendored trees are unverified, not an installed 50-emulator suite.
      Stock OpenDingux OPK binaries are not musl-compatible by default.

config BR2_PACKAGE_OPENDINGUX_EMULATORS_MINIMAL
    bool
    default y if BR2_PACKAGE_OPENDINGUX_EMULATORS

config BR2_PACKAGE_OPENDINGUX_EMULATORS_DEBUG
    bool "Keep PocketSNES debug symbols"
    depends on BR2_PACKAGE_OPENDINGUX_EMULATORS
