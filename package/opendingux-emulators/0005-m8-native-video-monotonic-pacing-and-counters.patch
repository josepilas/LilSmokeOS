--- a/sal/linux/sal.c
+++ b/sal/linux/sal.c
@@ -3,6 +3,7 @@
 #include <SDL.h>
 #include <sys/time.h>
 #include "sal.h"
+#include "m8_pocketsnes.h"
 
 #define PALETTE_BUFFER_LENGTH	256*2*4
 #define SNES_WIDTH  256
@@ -204,6 +205,25 @@
 void sal_VideoEnterGame(u32 fullscreenOption, u32 pal, u32 refreshRate)
 {
 #ifdef GCW_ZERO
+	if (SDL_MUSTLOCK(mScreen)) SDL_UnlockSurface(mScreen);
+	m8_video_set_native(0);
+	mScreen = SDL_SetVideoMode(256, pal ? 239 : 224, mBpp, SDL_SWSURFACE | SDL_FULLSCREEN);
+	if (mScreen && mScreen->w == 256 && mScreen->format->BitsPerPixel == 16 && m8_video_aspect())
+	{
+		m8_video_set_native(1);
+		mRefreshRate = refreshRate;
+		if (SDL_MUSTLOCK(mScreen)) SDL_LockSurface(mScreen);
+		return;
+	}
+	mScreen = SDL_SetVideoMode(SAL_SCREEN_WIDTH, SAL_SCREEN_HEIGHT, mBpp,
+		SDL_SWSURFACE | SDL_FULLSCREEN);
+	if (!mScreen) { fprintf(stderr, "POCKETSNES_VIDEO_FAILED %s\n", SDL_GetError()); exit(1); }
+	fprintf(stderr, "POCKETSNES_VIDEO fallback=320x240 aspect=4:3 scale_passes=2\n");
+	mRefreshRate = refreshRate;
+	if (SDL_MUSTLOCK(mScreen)) SDL_LockSurface(mScreen);
+	return;
+#endif
+#if defined(GCW_ZERO) && !defined(LILSMOKE_M8)
 	/* Copied from C++ headers which we can't include in C */
 	unsigned int Width = 256 /* SNES_WIDTH */,
 	             Height = pal ? 239 /* SNES_HEIGHT_EXTENDED */ : 224 /* SNES_HEIGHT */;
@@ -233,7 +253,7 @@
 
 void sal_VideoSetPAL(u32 fullscreenOption, u32 pal)
 {
-	if (fullscreenOption == 3) /* hardware scaling */
+	if (m8_video_native() || fullscreenOption == 3)
 	{
 		sal_VideoEnterGame(fullscreenOption, pal, mRefreshRate);
 	}
@@ -242,6 +262,7 @@
 void sal_VideoExitGame()
 {
 #ifdef GCW_ZERO
+	m8_video_set_native(0);
 	if (SDL_MUSTLOCK(mScreen)) SDL_UnlockSurface(mScreen);
 	mScreen = SDL_SetVideoMode(SAL_SCREEN_WIDTH, SAL_SCREEN_HEIGHT, mBpp, SDL_SWSURFACE | SDL_FULLSCREEN | SDL_DOUBLEBUF);
 	if (SDL_MUSTLOCK(mScreen)) SDL_LockSurface(mScreen);
