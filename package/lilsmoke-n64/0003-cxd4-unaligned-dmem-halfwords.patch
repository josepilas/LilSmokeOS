From: LilSmokeOS contributors
Subject: [PATCH] cxd4: permit unaligned DMEM vector halfword access on MIPS

The odd-address LDV/SDV ABI paths use pi16 casts which fault on MIPS.
Use GCC's alignment-1 alias type for DMEM only, retaining native endian
semantics and preserving DRAM DMA access. SM64 reproduces SIGBUS in LDV.

--- a/mupen64plus-rsp-cxd4/su.c
+++ b/mupen64plus-rsp-cxd4/su.c
@@ -16,1 +16,4 @@
-#include "su.h"
+#include "su.h"
+
+/* DMEM vector transfers may start at odd byte addresses. */
+typedef signed short rsp_unaligned_i16 __attribute__((aligned(1), may_alias));
@@ -645,1 +648,1 @@
-    VR_S(vt, e) = *(pi16)(DMEM + addr - correction);
+    VR_S(vt, e) = *(rsp_unaligned_i16 *)(DMEM + addr - correction);
@@ -670,1 +673,1 @@
-    VR_S(vt, e+0x0) = *(pi16)(DMEM + addr - correction);
+    VR_S(vt, e+0x0) = *(rsp_unaligned_i16 *)(DMEM + addr - correction);
@@ -672,1 +675,1 @@
-    VR_S(vt, e+0x2) = *(pi16)(DMEM + addr + correction);
+    VR_S(vt, e+0x2) = *(rsp_unaligned_i16 *)(DMEM + addr + correction);
@@ -688,1 +691,1 @@
