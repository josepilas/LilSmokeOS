# LilSmokeOS — Linux kernel config for QEMU-mipsel (malta board)
#
# Minimal MIPS kernel for LilSmokeOS development.
# Real hardware (SF3000/GB350) will get its own config in J4.
#
# Compiler: gcc-mipsel  (74Kf tuned, hard float, musl userland)
# Boot: vmlinux + appended DTB, loaded by QEMU's -kernel flag
# Filesystems: squashfs, ext4, vfat, overlayfs, tmpfs
# Devices: framebuffer (no GPU), ALSA (malta AC97), USB input (evdev)

CONFIG_MIPS=y
CONFIG_MIPS_MALTA=y
CONFIG_CPU_MIPS32_R2=y
CONFIG_CPU_HAS_DSP=y
CONFIG_CPU_HAS_DSPR2=y
CONFIG_64BIT=n
CONFIG_MIPS_FP_SUPPORT=y
CONFIG_SYS_SUPPORTS_32BIT_KERNEL=y
CONFIG_CPU_LITTLE_ENDIAN=y
CONFIG_CPU_MIPS32=y
CONFIG_CPU_MIPSR2=y
CONFIG_SYS_HAS_CPU_MIPS32_R2=y
CONFIG_HARDWARE_WATCHPOINTS=y

# MIPS DSP ASE — used by some emu cores
CONFIG_MIPS_DSP=y
CONFIG_MIPS_DSPR2=y

# Highmem off — we only have 256MB anyway
CONFIG_HIGHMEM=n

# --- Boot options ---
CONFIG_MIPS_AUTOLOAD_DTB=y
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="console=ttyS0,115200n8"
CONFIG_CMDLINE_OVERRIDE=n

# --- Malta serial console (boot diagnostics and headless QA) ---
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# --- Memory ---
CONFIG_FLATMEM=y
CONFIG_SYSVIPC=y
CONFIG_FLAT_NODE_MEM_MAP=y

# --- Bus / PCI (malta uses PCI; some real MIPS SoCs don't) ---
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_PCI_LEGACY=y

# --- Filesystems ---
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_EXT2_FS=y
CONFIG_EXT3_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_FS=y
CONFIG_MSDOS_FS=y
CONFIG_FAT_DEFAULT_CODEPAGE=437
CONFIG_FAT_DEFAULT_IOCHARSET="iso8859-1"
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_EXFAT_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_LZO=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_XATTR=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVPTS_FS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_9P_FS=y
CONFIG_9P_FS_POSIX_ACL=y

# --- Block devices ---
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_RAM=y
CONFIG_BLK_DEV_RAM_SIZE=16384
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE=""
CONFIG_VIRTIO_BLK=y

# --- SCSI / SD card (real HW uses MMC; malta uses virtio/IDE for testing) ---
CONFIG_BLK_DEV_SD=y
CONFIG_ATA=y
CONFIG_ATA_PIIX=y

# --- MMC (real hardware — enable now so SF3000 defconfig inherits cleanly) ---
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_BLOCK_MINORS=8

# --- Display / framebuffer (NO GPU — direct fbdev) ---
CONFIG_FB=y
CONFIG_FB_TILEBLITTING=y
CONFIG_FB_SOFT_CURSOR=y
CONFIG_FB_Y_FOLD=y
CONFIG_FB_DEFERRED_IO=y
CONFIG_FB_MODE_HELPERS=y
# Malta exposes a Cirrus CL-GD5446 PCI VGA device in QEMU.
CONFIG_FB_CIRRUS=y
CONFIG_VGA_CONSOLE=y
CONFIG_DUMMY_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
CONFIG_LOGO=y
CONFIG_LOGO_LINUX_CLUT224=y

# DirectFB requires the framebuffer console / fbdev
CONFIG_FB_CON_DECOR=y

# --- Input (evdev + USB HID + gamepad via xpad) ---
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_JOYDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_SERIO_LIBPS2=y
CONFIG_INPUT_JOYSTICK=y
CONFIG_INPUT_UINPUT=y
CONFIG_JOYSTICK_XPAD=y
CONFIG_HID=y
CONFIG_HIDRAW=y
CONFIG_UHID=y
CONFIG_USB_HID=y
CONFIG_HID_GENERIC=y
CONFIG_HID_MICROSOFT=y
CONFIG_HID_SONY=y
CONFIG_HID_PLAYSTATION=y
CONFIG_HID_LOGITECH=y
CONFIG_HID_NINTENDO=y
CONFIG_HID_DRAGONRISE=y

# --- USB (for gamepads + USB storage on real HW) ---
CONFIG_USB=y
CONFIG_USB_ANNOUNCE_NEW_DEVICES=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_UHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_SERIAL=y
CONFIG_CONFIGFS_FS=y
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_POWER_SUPPLY=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_CLASS_MULTICOLOR=y
CONFIG_CRC32=y

# --- Sound (ALSA, no PulseAudio) ---
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_HRTIMER=y
CONFIG_SND_PCM=y
CONFIG_SND_TIMER=y
CONFIG_SND_RAWMIDI=y
CONFIG_SND_SEQUENCER=y
CONFIG_SND_DRIVERS=y
CONFIG_SND_PCI=y
# Malta AC97
CONFIG_SND_INTEL8X0=y
CONFIG_SND_USB_AUDIO=y
CONFIG_SND_USB_UA101=y

# --- Network (only for QEMU/dev; on real HW WiFi is module-loaded on demand) ---
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_INET=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_NETDEVICES=y
CONFIG_NET_ETHERNET=y
CONFIG_MIPSNET=y
CONFIG_PCNET32=y
CONFIG_VIRTIO_NET=y
# Real hardware: RTL8188FU / RTL8189FS / 8723ds (loadable modules)
CONFIG_WLAN=y
CONFIG_RTL8188FU=m
CONFIG_RTL8723BS=m

# --- Crypto (for OTA bundle signatures) ---
CONFIG_CRYPTO=y
CONFIG_CRYPTO_HASH=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_CTR=y
CONFIG_CRYPTO_GCM=y

# --- Power management (mostly disabled — handhelds want instant-on/suspend) ---
CONFIG_PM=y
CONFIG_PM_SLEEP=n
CONFIG_SUSPEND=n
CONFIG_HIBERNATION=n
CONFIG_CPU_IDLE=y

# --- Compression (used by squashfs, initramfs, zram) ---
CONFIG_DECOMPRESS_GZIP=y
CONFIG_DECOMPRESS_XZ=y
CONFIG_DECOMPRESS_LZO=y
CONFIG_ZLIB_INFLATE=y
CONFIG_ZLIB_DEFLATE=y
CONFIG_LZO_COMPRESS=y
CONFIG_LZO_DECOMPRESS=y
CONFIG_XZ_DEC=y

# --- zram (48 MB LZ4 swap on 128-256 MB devices) ---
CONFIG_ZRAM=y
CONFIG_ZRAM_WRITEBACK=y
CONFIG_CRYPTO_LZ4=y
CONFIG_ZRAM_DEF_COMP_LZ4=y
CONFIG_ZSMALLOC=y
CONFIG_SWAP=y

# --- Debug (minimal — J7 will tune) ---
CONFIG_PRINTK=y
CONFIG_EARLY_PRINTK=y
CONFIG_DEBUG_INFO=n
CONFIG_MAGIC_SYSRQ=y

# --- Misc ---
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_MIPS_BPF=n
CONFIG_UEVENT_HELPER=y
CONFIG_UEVENT_HELPER_PATH=""
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_USER_HELPER=n
# Additional wired/USB-receiver gamepads (kernel support, not physical validation).
CONFIG_JOYSTICK_XPAD_FF=y
CONFIG_JOYSTICK_XPAD_LEDS=y
CONFIG_INPUT_FF_MEMLESS=y
CONFIG_HID_LOGITECH_DJ=y
CONFIG_HID_LOGITECH_HIDPP=y
CONFIG_LOGITECH_FF=y
CONFIG_HID_THRUSTMASTER=y
CONFIG_HID_PANTHERLORD=y
CONFIG_HID_GREENASIA=y
CONFIG_HID_SMARTJOYPLUS=y
CONFIG_HID_ZEROPLUS=y
CONFIG_HID_HOLTEK=y
CONFIG_HID_STEAM=y
CONFIG_HID_BETOP_FF=y
CONFIG_HID_SAITEK=y
CONFIG_HID_SPEEDLINK=y
