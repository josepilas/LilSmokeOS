#
# LilSmokeOS — BusyBox config (QEMU + real HW share this)
#
# Minimal, but includes the bits we need:
# - vi, find, xargs, grep, sed, awk (basic shell productivity)
# - basename, dirname, mv, stat, tr (runtime helpers / 7z cache)
# - udhcpc/udhcpd, ifconfig, route, wget (WiFi and USB networking)
# - mdev (hotplug — much lighter than udev)
# - mount/umount with all our filesystem types
# - switch_root, pivot_root (for initramfs → squashfs handover)
# - fdisk, mkfs.ext2, mkfs.vfat (for SD card init in J8)
# - sysctl, sysrq, watchdog (system recovery)
#
# This is a *fragment* — Buildroot merges it with the defconfig.

CONFIG_FEATURE_HAVE_RPC=n
CONFIG_FEATURE_INETD=n
CONFIG_FEATURE_TELNETD=y
CONFIG_UDHCPD=y
CONFIG_FEATURE_UDHCPD_WRITE_LEASES_EARLY=y
CONFIG_UDHCPC=y
CONFIG_IFCONFIG=y
CONFIG_ROUTE=y
CONFIG_WGET=y
CONFIG_FEATURE_WGET_STATUSBAR=y
CONFIG_FEATURE_WGET_AUTHENTICATION=y
CONFIG_FEATURE_WGET_LONG_OPTIONS=y

# Init / shell
CONFIG_INIT=y
CONFIG_FEATURE_USE_INITTAB=y
CONFIG_HUSH=y
CONFIG_ASH=y
CONFIG_FEATURE_SH_IS_ASH=y
CONFIG_BASH_IS_NONE=y
CONFIG_LOGIN=y
CONFIG_PASSWD=y
CONFIG_CHPASSWD=y
# CONFIG_SU is not set
CONFIG_FEATURE_SHADOWPASSWDS=y

# Filesystem tools we actually use
CONFIG_FDISK=y
CONFIG_MKFS_EXT2=y
CONFIG_MKFS_VFAT=y
CONFIG_MOUNT=y
CONFIG_UMOUNT=y
CONFIG_FEATURE_MOUNT_FLAGS=y
CONFIG_FEATURE_MOUNT_LABEL=y
CONFIG_FEATURE_MOUNT_HELPERS=y
CONFIG_FEATURE_MOUNT_LOOP=y
CONFIG_MOUNTPOINT=y
CONFIG_RMDIR=y
CONFIG_START_STOP_DAEMON=y
CONFIG_FEATURE_START_STOP_DAEMON_LONG_OPTIONS=y
CONFIG_FEATURE_START_STOP_DAEMON_FANCY=y
CONFIG_IP=y
CONFIG_FEATURE_IP_ADDRESS=y
CONFIG_FEATURE_IP_LINK=y
CONFIG_FEATURE_IP_ROUTE=y
CONFIG_IPADDR=y
CONFIG_CKSUM=y
CONFIG_CAT=y
CONFIG_CP=y
CONFIG_DD=y
CONFIG_LS=y
CONFIG_CHMOD=y
CONFIG_CHOWN=y
CONFIG_OD=y
CONFIG_TEST=y
CONFIG_HEAD=y
CONFIG_SYNC=y
CONFIG_FEATURE_STAT_FILESYSTEM=y
CONFIG_BLKID=y
CONFIG_SWITCH_ROOT=y
CONFIG_PIVOT_ROOT=y

# Process / debug
CONFIG_TOP=y
CONFIG_PS=y
CONFIG_KILL=y
CONFIG_KILLALL=y
CONFIG_KILLALL5=y
CONFIG_FEATURE_SYSCTL=y
CONFIG_WATCHDOG=y

# Editors / text tools
CONFIG_VI=y
CONFIG_FEATURE_VI_MAX_LEN=4096
CONFIG_SED=y
CONFIG_AWK=y
CONFIG_GREP=y
CONFIG_FIND=y
CONFIG_XARGS=y
CONFIG_BASENAME=y
CONFIG_DIRNAME=y
CONFIG_LN=y
CONFIG_MKDIR=y
CONFIG_MV=y
CONFIG_RM=y
CONFIG_STAT=y
CONFIG_FEATURE_STAT_FORMAT=y
CONFIG_TR=y

# Compression (for OTA bundle unpack)
CONFIG_GZIP=y
CONFIG_GUNZIP=y
CONFIG_BZIP2=y
CONFIG_BUNZIP2=y
CONFIG_XZ=y
CONFIG_UNXZ=y
CONFIG_UNZIP=y
CONFIG_TAR=y
CONFIG_FEATURE_TAR_XZ=y
CONFIG_FEATURE_TAR_GZIP=y
CONFIG_FEATURE_TAR_BZIP2=y

# mdev (hotplug — way lighter than udev)
CONFIG_MDEV=y
CONFIG_FEATURE_MDEV_CONF=y
CONFIG_FEATURE_MDEV_DAEMON=y
CONFIG_FEATURE_MDEV_EXEC=y
CONFIG_FEATURE_MDEV_LOAD_FIRMWARE=y
CONFIG_DIFF=y
CONFIG_FEATURE_DIFF_DIR=y
CONFIG_SHA256SUM=y
CONFIG_FEATURE_BLKID_TYPE=y
