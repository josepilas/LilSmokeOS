# LilSmokeOS — Linux kernel config for VirtualBox x86_64
#
# Generic x86_64 kernel for VirtualBox guests. Boots via ISOLINUX from
# the generated ISO. Uses VESA framebuffer (no GPU acceleration), AC97
# audio (VBox's default audio controller), and E1000 NIC (VBox's
# default network adapter).
#
# Compiler: gcc x86_64  (host build, glibc or musl)
# Boot: ISOLINUX → bzImage → initramfs (or squashfs on p2)
# Filesystems: squashfs, ext4, vfat, overlayfs, tmpfs, iso9660
# Devices: VESA fb (no GPU), AC97 audio, E1000 net, PS/2 input

CONFIG_X86_64=y
CONFIG_64BIT=y
CONFIG_X86=y
CONFIG_INSTRUCTION_DECODER=y
CONFIG_OUTPUT_FORMAT="elf64-x86-64"
CONFIG_ARCH_MMAP_RND_BITS_MIN=28
CONFIG_ARCH_MMAP_RND_BITS_MAX=32
CONFIG_GENERIC_CALIBRATE_DELAY=y
CONFIG_GENERIC_TIME_VSYSCALL=y
CONFIG_GENERIC_CLOCKEVENTS=y
CONFIG_ARCH_HAS_CPU_RELAX=y
CONFIG_ARCH_HAS_CACHE_LINE_SIZE=y

# --- CPU ---
CONFIG_MK8=y                  # Optimize for K8+ (works fine on all modern x86_64)
CONFIG_GENERIC_CPU=n
CONFIG_X86_64_X32=n
CONFIG_SMP=y
CONFIG_NR_CPUS=4
CONFIG_PREEMPT_VOLUNTARY=y
CONFIG_HZ_250=y
CONFIG_HZ=250

# --- Boot options ---
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="console=tty0 console=ttyS0,115200n8 root=/dev/ram0 rdinit=/init"
CONFIG_CMDLINE_OVERRIDE=n

# --- Bus / PCI (VirtualBox uses PCI for E1000, AC97) ---
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCI_DIRECT=y
CONFIG_PCI_MMCONFIG=y
CONFIG_ISA=y
CONFIG_ISAPNP=y

# --- Filesystems ---
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_EXT2_FS=y
CONFIG_EXT3_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_FS=y
CONFIG_MSDOS_FS=y
CONFIG_FAT_DEFAULT_CODEPAGE=437
CONFIG_FAT_DEFAULT_IOCHARSET="iso8859-1"
CONFIG_EXFAT_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_LZO=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_XATTR=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVPTS_FS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_ISO9660_FS=y

# --- Block devices ---
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_RAM=y
CONFIG_BLK_DEV_RAM_SIZE=16384
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE=""
CONFIG_CDROM=y
CONFIG_BLK_DEV_SR=y
CONFIG_BLK_DEV_SR_VENDOR=y

# --- SCSI / SD (needed for SATA CD and USB storage) ---
CONFIG_BLK_DEV_SD=y
CONFIG_ATA=y
CONFIG_ATA_PIIX=y
CONFIG_SATA_AHCI=y

# --- MMC (real HW uses MMC; VBox has none but enable for portability) ---
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y

# --- Display / framebuffer (NO GPU — VESA fbdev only) ---
CONFIG_FB=y
CONFIG_FB_TILEBLITTING=y
CONFIG_FB_SOFT_CURSOR=y
CONFIG_FB_Y_FOLD=y
CONFIG_FB_DEFERRED_IO=y
# VESA framebuffer — the only one that works in VirtualBox without
# Guest Additions. 640x480 at vga=785 (16-bit) or vga=788 (32-bit).
CONFIG_FB_VESA=y
CONFIG_FB_EFI=y
CONFIG_VGA_CONSOLE=y
CONFIG_DUMMY_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
CONFIG_LOGO=y
CONFIG_LOGO_LINUX_CLUT224=y

# DirectFB requires the framebuffer console
CONFIG_FB_CON_DECOR=y

# --- Input (evdev + keyboard + USB HID + gamepad) ---
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_JOYDEV=y
CONFIG_INPUT_JOYSTICK=y
CONFIG_JOYSTICK_XPAD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_HID=y
CONFIG_HIDRAW=y
CONFIG_UHID=y
CONFIG_USB_HID=y
CONFIG_HID_GENERIC=y
CONFIG_HID_MICROSOFT=y
CONFIG_HID_SONY=y
CONFIG_HID_PLAYSTATION=y
CONFIG_HID_LOGITECH=y
CONFIG_HID_NINTENDO=y
CONFIG_HID_DRAGONRISE=y

# --- USB (gamepads + USB storage on real HW) ---
CONFIG_USB=y
CONFIG_USB_ANNOUNCE_NEW_DEVICES=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_CONFIGFS_FS=y
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_POWER_SUPPLY=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_CLASS_MULTICOLOR=y
CONFIG_CRC32=y
CONFIG_USB_SERIAL=y

# --- Sound (ALSA — VirtualBox uses Intel AC97 by default) ---
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_HRTIMER=y
CONFIG_SND_PCM=y
CONFIG_SND_TIMER=y
CONFIG_SND_RAWMIDI=y
CONFIG_SND_SEQUENCER=y
CONFIG_SND_DRIVERS=y
CONFIG_SND_PCI=y
# Intel AC97 — VirtualBox default audio controller
CONFIG_SND_INTEL8X0=y
# Intel HDA — for VBox guests configured with HDA audio
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_GENERIC=y
CONFIG_SND_USB_AUDIO=y
CONFIG_SND_USB_UA101=y

# --- Network (E1000 — VirtualBox default NIC) ---
CONFIG_NET=y
CONFIG_INET=y
CONFIG_NETDEVICES=y
CONFIG_NET_ETHERNET=y
CONFIG_NET_PCI=y
CONFIG_E1000=y
CONFIG_E1000E=y
# Real hardware WiFi drivers — modules, loaded on demand
CONFIG_WLAN=y
CONFIG_RTL8188FU=m
CONFIG_RTL8723BS=m

# --- Crypto (for OTA bundle signatures) ---
CONFIG_CRYPTO=y
CONFIG_CRYPTO_HASH=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_CTR=y
CONFIG_CRYPTO_GCM=y

# --- Power management ---
CONFIG_PM=y
CONFIG_PM_SLEEP=n
CONFIG_SUSPEND=n
CONFIG_HIBERNATION=n
CONFIG_CPU_IDLE=y

# --- Compression ---
CONFIG_DECOMPRESS_GZIP=y
CONFIG_DECOMPRESS_XZ=y
CONFIG_DECOMPRESS_LZO=y
CONFIG_ZLIB_INFLATE=y
CONFIG_ZLIB_DEFLATE=y
CONFIG_LZO_COMPRESS=y
CONFIG_LZO_DECOMPRESS=y
CONFIG_XZ_DEC=y

# --- zram (48 MB LZ4 swap, matching the handheld default) ---
CONFIG_ZRAM=y
CONFIG_ZRAM_WRITEBACK=y
CONFIG_ZRAM_LZ4_COMPRESS=y
CONFIG_ZSMALLOC=y
CONFIG_SWAP=y

# --- Debug ---
CONFIG_PRINTK=y
CONFIG_EARLY_PRINTK=y
CONFIG_DEBUG_INFO=n
CONFIG_MAGIC_SYSRQ=y

# --- Misc ---
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_UEVENT_HELPER=y
CONFIG_UEVENT_HELPER_PATH=""
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_USER_HELPER=n
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_HW_CONSOLE=y
CONFIG_ACPI=y
CONFIG_ACPI_BUTTON=y
CONFIG_ACPI_FAN=y
CONFIG_ACPI_THERMAL=y
# Additional wired/USB-receiver gamepads (kernel support, not physical validation).
CONFIG_JOYSTICK_XPAD_FF=y
CONFIG_JOYSTICK_XPAD_LEDS=y
CONFIG_INPUT_FF_MEMLESS=y
CONFIG_HID_LOGITECH_DJ=y
CONFIG_HID_LOGITECH_HIDPP=y
CONFIG_LOGITECH_FF=y
CONFIG_HID_THRUSTMASTER=y
CONFIG_HID_PANTHERLORD=y
CONFIG_HID_GREENASIA=y
CONFIG_HID_SMARTJOYPLUS=y
CONFIG_HID_ZEROPLUS=y
CONFIG_HID_HOLTEK=y
CONFIG_HID_STEAM=y
CONFIG_HID_BETOP_FF=y
CONFIG_HID_SAITEK=y
CONFIG_HID_SPEEDLINK=y
