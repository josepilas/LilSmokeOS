# LilSmokeOS additions to the pinned linux-hichip sf3000_defconfig.
#
# The upstream board config already enables MUSB HC16xx gadget support,
# ConfigFS ECM/RNDIS, and a loop device. These options add the mass-storage
# function and host-side HID support needed by LILDRIVE, keyboards, mice, and
# PlayStation touchpads. The HC16xx UDC/PHY and the board's OTG ID/VBUS wiring
# must still be validated on each hardware revision.

CONFIG_USB=y
CONFIG_USB_OTG=y
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_DUAL_ROLE=y
CONFIG_USB_MUSB_HC16XX=y

CONFIG_CONFIGFS_FS=y
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_MSDOS_PARTITION=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y
CONFIG_EXT4_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_HID_SONY=y
CONFIG_HID_PLAYSTATION=y
CONFIG_POWER_SUPPLY=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_CLASS_MULTICOLOR=y
CONFIG_CRC32=y
# Additional wired/USB-receiver gamepads (kernel support, not physical validation).
CONFIG_INPUT_JOYDEV=y
CONFIG_INPUT_JOYSTICK=y
CONFIG_INPUT_UINPUT=y
CONFIG_JOYSTICK_XPAD=y
CONFIG_JOYSTICK_XPAD_FF=y
CONFIG_JOYSTICK_XPAD_LEDS=y
CONFIG_INPUT_FF_MEMLESS=y
CONFIG_HID_MICROSOFT=y
CONFIG_HID_LOGITECH=y
CONFIG_HID_LOGITECH_DJ=y
CONFIG_HID_LOGITECH_HIDPP=y
CONFIG_LOGITECH_FF=y
CONFIG_HID_NINTENDO=y
CONFIG_HID_DRAGONRISE=y
CONFIG_HID_THRUSTMASTER=y
CONFIG_HID_PANTHERLORD=y
CONFIG_HID_GREENASIA=y
CONFIG_HID_SMARTJOYPLUS=y
CONFIG_HID_ZEROPLUS=y
CONFIG_HID_HOLTEK=y
CONFIG_HID_STEAM=y
CONFIG_HID_BETOP_FF=y
CONFIG_HID_SAITEK=y
CONFIG_HID_SPEEDLINK=y
