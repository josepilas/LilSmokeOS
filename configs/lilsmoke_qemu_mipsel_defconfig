# LilSmokeOS — QEMU-mipsel (malta) defconfig
#
# This is the development target. Boots in QEMU-system-mipsel using the
# malta board emulation. Use scripts/run-qemu.sh after building.
#
# Usage:
#   cd /path/to/buildroot
#   make BR2_EXTERNAL=/path/to/lilsmoke-os lilsmoke_qemu_mipsel_defconfig
#   make
#   /path/to/lilsmoke-os/scripts/run-qemu.sh output/images

# --- Toolchain ---
BR2_mipsel=y
BR2_mips_32r2=y
# Keep legacy NaN encoding for parity with the real console ABI.
# BR2_MIPS_NAN_2008 is not set
BR2_TOOLCHAIN_BUILDROOT_GLIBC=n
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_TOOLCHAIN_BUILDROOT_FORTRAN=n
# Kernel headers (for the toolchain API level — doesn't need to match the
# running kernel). Use 6.6 LTS headers explicitly to match Buildroot's default.
BR2_KERNEL_HEADERS_6_6=y
# BR2_KERNEL_HEADERS_AS_KERNEL is not set
BR2_TOOLCHAIN_BUILDROOT_USE_SSP=y

# MIPS DSP ASE — enables DSP intrinsics in hot loops (used by some emu cores)
BR2_MIPS_DSP=y
BR2_MIPS_DSPR2=y

# C fixed-point language/runtime helpers are not used by LilSmokeOS and make
# MIPS libgcc enormous to build; keep the toolchain lean for this target.
BR2_EXTRA_GCC_CONFIG_OPTIONS="--disable-fixed-point --disable-libstdcxx-pch"

# Hard float (matches the real target FPU ABI)
# BR2_MIPS_SOFT_FLOAT is not set

# --- Build options ---
BR2_OPTIMIZE_3=y
BR2_TARGET_OPTIMIZATION="-mtune=74kc -mdspr2 -mfp32 -mhard-float -mplt -mlong-calls"
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_LILSMOKE_PATH)/patches"
BR2_SSP_STRONG=y
BR2_PIC=y
BR2_RELRO_FULL=y
BR2_FORTIFY_SOURCE_2=y
BR2_INIT_BUSYBOX=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_MDEV=y
BR2_TARGET_GENERIC_ROOT_PASSWD=""
BR2_TARGET_GENERIC_GETTY_PORT="ttyS0"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y
BR2_SYSTEM_DHCP="eth0"

# --- Kernel ---
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="5.15.148"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_LILSMOKE_PATH)/board/qemu-mipsel/linux.config"
# Malta uses QEMU's legacy kernel boot protocol.  The standard vmlinux
# selection tells Buildroot that the ELF lives at the kernel source root.
BR2_LINUX_KERNEL_VMLINUX=y
# No FIT image needed for QEMU (we boot vmlinux + initramfs directly via -kernel/-initrd).
# The real HC16xx boot chain is still under investigation and is not U-Boot.
# BR2_LINUX_KERNEL_DTS_SUPPORT is not set

# --- Filesystem ---
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_GZIP=y
# SquashFS — what we ship on real hardware; useful to test in QEMU too
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_XZ=y

# --- Userspace: minimal, musl, no systemd, no X ---
BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
# Use our custom busybox config (enables vi, networking tools, etc.)
BR2_PACKAGE_BUSYBOX_CONFIG="$(BR2_EXTERNAL_LILSMOKE_PATH)/board/qemu-mipsel/busybox.config"

# Core utilities we actually need
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_E2FSPROGS_RESIZE2FS=y
BR2_PACKAGE_MTD=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_MOUNT=y
BR2_PACKAGE_UTIL_LINUX_UMOUNT=y
BR2_PACKAGE_UTIL_LINUX_FALLOCATE=y
BR2_PACKAGE_P7ZIP=y
BR2_PACKAGE_P7ZIP_7ZA=y
BR2_PACKAGE_UNRAR=y

# Network (only when WiFi toggled on)
BR2_PACKAGE_IW=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_DROPBEAR_DISABLE_REVERSEDNS=y

# LilSmokeOS packages
BR2_PACKAGE_LILSMOKE_OS=y
BR2_PACKAGE_LILSMOKE_APPS=y
BR2_PACKAGE_LILSMOKE_SCRIPTS=y
BR2_PACKAGE_LILSMOKE_UI=y

# --- J1: Media stack (DirectFB + SDL2 + ALSA + input + image libs) ---
BR2_PACKAGE_DIRECTFB=y
BR2_PACKAGE_DIRECTFB_MIPS=y
# DirectFB options: fbdev-only, no X, no GL
BR2_PACKAGE_DIRECTFB_UNIQUE_ID=y
BR2_PACKAGE_DIRECTFB_DIVINE=y
BR2_PACKAGE_DIRECTFB_JPEG=y
BR2_PACKAGE_DIRECTFB_PNG=y
BR2_PACKAGE_DIRECTFB_SDL=n
BR2_PACKAGE_DIRECTFB_SVG=n
BR2_PACKAGE_DIRECTFB_EXAMPLES=n
BR2_PACKAGE_DIRECTFB_TESTS=n
BR2_PACKAGE_DIRECTFB_GIF=y
BR2_PACKAGE_DIRECTFB_IMLIB2=n
BR2_PACKAGE_DIRECTFB_TSLIB=n
BR2_PACKAGE_DIRECTFB_X11=n
BR2_PACKAGE_DIRECTFB_DEBUG=n
BR2_PACKAGE_DIRECTFB_TRACE=n
# SDL2 on DirectFB (no OpenGL/GLES — there's no GPU on this device)
BR2_PACKAGE_SDL2=y
BR2_PACKAGE_SDL2_DIRECTFB=y
BR2_PACKAGE_SDL2_OPENGLES=n
BR2_PACKAGE_SDL2_OPENGL=n
BR2_PACKAGE_SDL2_X11=n
BR2_PACKAGE_SDL2_WAYLAND=n
BR2_PACKAGE_SDL2_KMS=n
BR2_PACKAGE_SDL2_PIPEWIRE=n
BR2_PACKAGE_SDL2_NAS=n
BR2_PACKAGE_SDL2_ALSA=y
BR2_PACKAGE_LILSMOKE_USB_GAMEPADS=y
BR2_PACKAGE_SDL2_VIRTUAL_JOYSTICK=y
# ALSA + sound tools
BR2_PACKAGE_ALSA_LIB=y
BR2_PACKAGE_ALSA_LIB_TOPOLOGY=n
BR2_PACKAGE_ALSA_LIB_RAWMIDI=y
BR2_PACKAGE_ALSA_LIB_HWDEP=y
BR2_PACKAGE_ALSA_LIB_SEQ=y
BR2_PACKAGE_ALSA_LIB_ALISP=n
BR2_PACKAGE_ALSA_LIB_OLD_SYMBOLS=n
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_ALSACTL=y
BR2_PACKAGE_ALSA_UTILS_ALSAMIXER=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
BR2_PACKAGE_ALSA_UTILS_SPEAKER_TEST=y
# Input (evdev is in the kernel, libevdev adds a thin userland API)
BR2_PACKAGE_LIBEVDEV=y
# Image libraries (for cover art / theme assets)
BR2_PACKAGE_LIBPNG=y
BR2_PACKAGE_WEBP=y
BR2_PACKAGE_WEBP_DEMUX=y
BR2_PACKAGE_LIBJPEG=y
BR2_PACKAGE_LIBJPEG_TURBO=y
# Fonts
BR2_PACKAGE_DEJAVU=y
BR2_PACKAGE_LIBERATION=y
BR2_PACKAGE_FONTCONFIG=y
BR2_PACKAGE_FREETYPE=y

# --- J1: LilSmokeOS fbdev test app (paints the logo to /dev/fb0) ---
BR2_PACKAGE_LILSMOKE_FBTEST=y

# --- J2: RetroArch + 8 curated MIPS cores ---
BR2_PACKAGE_RETROARCH_MIPS=y
BR2_PACKAGE_RETROARCH_MIPS_SNES_QA=y
BR2_PACKAGE_PCSX4ALL=y
BR2_PACKAGE_OPENDINGUX_EMULATORS=y

# Native PSX frontend is built from source; hardware performance is unverified.
# Bluetooth remains build-time opt-in with BR2_PACKAGE_LILSMOKE_BLUETOOTH.

# --- Bootloader (QEMU uses its own BIOS, no U-Boot needed) ---
# Real HC16xx targets are guarded until their production boot adapter is known.

# --- Host tools needed to build images ---
BR2_PACKAGE_HOST_SQUASHFS=y
BR2_PACKAGE_HOST_MKPASSWD=y
BR2_PACKAGE_HOST_FAKETIME=y
